# Up&In Family Office de l'Autonomie — hébergement OVH (déploiement automatique depuis GitHub)
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
RedirectMatch 404 ^/tools(/.*)?$
AddDefaultCharset UTF-8

RewriteEngine On
# HTTPS + domaine sans www -> www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^upandin-autonomie\.fr$ [NC]
RewriteRule ^(.*)$ https://www.upandin-autonomie.fr/$1 [R=301,L]
# Une seule adresse par page (évite le contenu dupliqué pour les moteurs)
RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
RewriteRule ^index\.html$ https://www.upandin-autonomie.fr/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/([^.\s?]+)\.html[\s?] [NC]
RewriteRule ^ https://www.upandin-autonomie.fr/%1 [R=301,L]
# URL propres : /mentions-legales -> mentions-legales.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Strict-Transport-Security "max-age=31536000"
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/xml text/plain application/json
</IfModule>
